# ============================================================================
# ROMs — copyright Square Enix, must NEVER be committed
# ============================================================================
*.bin
*.sfc
*.smc
*.srm
*.fig

# Vanilla ROM source directory (provided by user, not tracked)
vanilla/Final*Fantasy*
vanilla/ff4-*

# Built ROMs and derived assets inside the upstream submodule
upstream/rom/
upstream/vanilla/ff4-*

# ============================================================================
# Build artifacts
# ============================================================================
# C/clang
*.o
*.d
*.dSYM/

# Parity binaries (compiled artifacts)
parity/ff4-parity
parity/ff4-parity-compare
parity/ff4-spike-*

# cc65 listings + map files
**/*.lst
**/*.map

# LakeSnes desktop binary
LakeSnes/lakesnes
LakeSnes/lakesnes_app
LakeSnes/lakesnes.exe
LakeSnes/LakeSnes.app/

# Desktop validation host binaries (built from desktop/Makefile, ADR 0001)
desktop/ff4-desktop-headless
desktop/ff4-desktop-sdl
desktop/ff4-desktop-oracle
desktop/ff4-dbg-scroll
desktop/input_probe
desktop/wram_diff
desktop/wram_diff_dbg
desktop/miss_profiler
desktop/ppmdiff
desktop/trace_interp.txt
desktop/trace_native.txt

# Pre-made savestate seeds (provenance unconfirmed, see F2; large binaries)
*.lss

# ============================================================================
# Python
# ============================================================================
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.venv/
**/venv/
**/*.egg-info/
**/build/
**/dist/

# ============================================================================
# Node (upstream tooling)
# ============================================================================
**/node_modules/

# ============================================================================
# Translator runtime logs (may contain prompts/responses)
# ============================================================================
translator/batch_log.jsonl
translator/_failed/

# ============================================================================
# Generated C port (LLM output not yet reviewed)
# ============================================================================
# Note: keep port/ structure tracked via .gitkeep, but ignore unreviewed
# generated files. Reviewed wrappers can be committed individually.
port/**/_pending/
port/**/_failed/
port/_cascade/
port/_hardcore/
port/_iter1/

# ============================================================================
# Editor / OS
# ============================================================================
.DS_Store
.idea/
.vscode/
*.swp
*.swo
.zed/

# ============================================================================
# Workspace-specific (not for public repo)
# ============================================================================
# (none for now)

# P3 prompt-mutation loop intermediate artifacts
prompts/history/_candidate_*/
port/_mutation/
port/_regression/
translator/runs/reg_*.json
desktop/proof_cyc
